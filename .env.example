# ISDS — root .env.example
# Copy to .env and fill in values. Placeholder values (your_value_here) are treated as unset.

DATABASE_URL=mysql://root:your_password@localhost:3306/isds

# Leave empty in dev (Vite proxies /api to the backend). Set to the API origin in production.
VITE_API_URL=

# Firebase (optional — email/password login works without it)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_USE_AUTH_EMULATOR=false
