# ISDS — server/.env.example
# Copy to server/.env and fill in values. Placeholder values (your_value_here) are treated as unset.

NODE_ENV=development

DATABASE_URL=mysql://root:your_password@localhost:3306/isds

# Production: MUST be a long random value.
JWT_SECRET=your_value_here

# Secret key required to register admin/teacher/recruiter accounts. Production: random value.
ADMIN_SECRET_KEY=your_value_here

# Frontend origin — automatically added to the CORS allowlist.
FRONTEND_URL=http://localhost:5173

# Optional extra CORS origins, comma-separated.
CORS_ORIGINS=

PORT=5000

# --- Optional integrations ---

ANTHROPIC_API_KEY=your_value_here

FIREBASE_PROJECT_ID=your_value_here
FIREBASE_SERVICE_ACCOUNT_BASE64=your_value_here

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@isds.edu
